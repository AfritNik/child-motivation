{
  "name": "family-motivation-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:study-demo": "tsx prisma/study-demo.ts load",
    "db:study-demo:clear": "tsx prisma/study-demo.ts clear",
    "db:stage7-demo": "tsx prisma/stage7-demo.ts load",
    "db:stage7-demo:clear": "tsx prisma/stage7-demo.ts clear"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.24.4"
    }
  }
}
