# Создаётся на сервере как .env.production и не добавляется в Git.
# Все секреты генерируются отдельно; пароль БД лучше делать только из букв и цифр.
POSTGRES_PASSWORD=replace-with-random-letters-and-digits
AUTH_SECRET=replace-with-long-random-value
LOGIN_THROTTLE_SECRET=replace-with-another-long-random-value
PIN_SASHA=replace
PIN_PAPA=replace
PIN_GRANDPA=replace

# Приватное хранилище ежедневных резервных копий.
BACKUP_BUCKET=replace-with-private-bucket-name
BACKUP_AGE_RECIPIENT=age1replace-with-public-key
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace
